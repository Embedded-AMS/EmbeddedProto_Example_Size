; CDDL counterpart of command.proto for zcbor.

DeviceCommand = {
  ? sequence: 1 => uint,
  ? action: (
    set_output: 2 => bool //
    move_to: 3 => int //
    reboot_delay_ms: 4 => uint
  ),
}

DeviceAck = {
  ? sequence: 1 => uint,
  ? result: 2 => int,
}
