; CDDL counterpart of simple_types.proto for zcbor. Every field is an optional map entry
; keyed by its protobuf field number, so the wire carries the same information as
; protobuf: numbered, optional fields. Enums are integers.

Simple_Types = {
  ? a_int32: 1 => int,
  ? a_int64: 2 => int .size 8,
  ? a_uint32: 3 => uint,
  ? a_uint64: 4 => uint .size 8,
  ? a_sint32: 5 => int,
  ? a_sint64: 6 => int .size 8,
  ? a_bool: 7 => bool,
  ? a_enum: 8 => int,
  ? a_fixed64: 9 => uint .size 8,
  ? a_sfixed64: 10 => int .size 8,
  ? a_double: 11 => float64,
  ? a_fixed32: 12 => uint,
  ? a_sfixed32: 13 => int,
  ? a_float: 14 => float32,
  ? a_nested_enum: 15 => int,
}
