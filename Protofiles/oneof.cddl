; CDDL counterpart of oneof.proto for zcbor. The oneof is a choice of map entries.

OneOf_Demo = {
  ? data_field: (
    int32_value: 1 => int //
    int64_value: 2 => int .size 8 //
    uint32_value: 3 => uint //
    uint64_value: 4 => uint .size 8 //
    bool_value: 5 => bool //
    float_value: 6 => float32 //
    double_value: 7 => float64 //
    simple_types_value: 8 => Simple_Types
  ),
}
