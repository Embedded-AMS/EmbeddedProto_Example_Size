// FlatBuffers counterpart of command.proto. A union holds tables only, so each scalar
// action sits in a one-field table.

enum Result : int { UNKNOWN = 0, ACCEPTED = 1, REJECTED = 2, BUSY = 3 }

table SetOutput { value:bool; }
table MoveTo { value:int; }
table RebootDelayMs { value:uint; }

union Action { SetOutput, MoveTo, RebootDelayMs }

table DeviceCommand
{
  sequence:uint;
  action:Action;
}

table DeviceAck
{
  sequence:uint;
  result:Result;
}
