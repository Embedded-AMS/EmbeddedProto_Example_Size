; CDDL counterpart of configuration.proto for zcbor. The oneof is a choice of map entries.

UartConfig = {
  ? baud: 1 => uint,
  ? data_bits: 2 => uint,
  ? parity: 3 => bool,
}

SpiConfig = {
  ? prescaler: 1 => uint,
  ? cpol: 2 => bool,
  ? cpha: 3 => bool,
}

MotorConfig = {
  ? max_speed: 1 => uint,
  ? invert: 2 => bool,
  ? home_pin: 3 => uint,
}

Peripheral = {
  ? index: 1 => uint,
  ? kind: (
    uart: 10 => UartConfig //
    spi: 11 => SpiConfig //
    motor: 12 => MotorConfig
  ),
}

Configuration = {
  ? version: 1 => uint,
  ? device_name: 2 => tstr,
  ? peripherals: 3 => [0*4 Peripheral],
  ? report_interval_ms: 4 => uint,
}
