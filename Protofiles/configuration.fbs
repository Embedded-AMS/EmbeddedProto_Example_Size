// FlatBuffers counterpart of configuration.proto. The oneof is a union of tables,
// the optional scalar is an optional scalar (= null).

table UartConfig { baud:uint; data_bits:uint; parity:bool; }
table SpiConfig { prescaler:uint; cpol:bool; cpha:bool; }
table MotorConfig { max_speed:uint; invert:bool; home_pin:uint; }

union Kind { UartConfig, SpiConfig, MotorConfig }

table Peripheral
{
  index:uint;
  kind:Kind;
}

table Configuration
{
  version:uint;
  device_name:string;
  peripherals:[Peripheral];
  report_interval_ms:uint = null;
}

root_type Configuration;
