// FlatBuffers counterpart of simple_types.proto. FlatBuffers has no nested enums,
// so Nested_Enum lives at file scope.

enum Test_Enum : int
{
  ZERO = 0,
  ONE = 1,
  TWO = 2,
  ONEHUNDERTTWENTYSEVEN = 127,
  ONEHUNDERTTWENTYEIGHT = 128,
  TWOHUNDERDFIFTYFIVE = 255,
  TWOBILLION = 2000000000
}

enum Nested_Enum : int
{
  NE_A = 0,
  NE_B = 1,
  NE_C = 2
}

table Simple_Types
{
  a_int32:int;
  a_int64:long;
  a_uint32:uint;
  a_uint64:ulong;
  a_sint32:int;
  a_sint64:long;
  a_bool:bool;
  a_enum:Test_Enum;
  a_fixed64:ulong;
  a_sfixed64:long;
  a_double:double;
  a_fixed32:uint;
  a_sfixed32:int;
  a_float:float;
  a_nested_enum:Nested_Enum;
}

root_type Simple_Types;
