// FlatBuffers counterpart of oneof.proto. A FlatBuffers union can only hold tables,
// so every scalar member of the oneof is wrapped in a one-field table.

include "simple_types.fbs";

table Int32_Value { value:int; }
table Int64_Value { value:long; }
table Uint32_Value { value:uint; }
table Uint64_Value { value:ulong; }
table Bool_Value { value:bool; }
table Float_Value { value:float; }
table Double_Value { value:double; }

union Data_Field
{
  Int32_Value,
  Int64_Value,
  Uint32_Value,
  Uint64_Value,
  Bool_Value,
  Float_Value,
  Double_Value,
  Simple_Types
}

table OneOf_Demo
{
  data_field:Data_Field;
}

root_type OneOf_Demo;
