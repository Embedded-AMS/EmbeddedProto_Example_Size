; CDDL counterpart of telemetry.proto for zcbor.

Telemetry = {
  ? device_id: 1 => uint,
  ? timestamp: 2 => uint .size 8,
  ? temperature: 3 => float32,
  ? humidity: 4 => float32,
  ? battery_mv: 5 => uint,
  ? status: 6 => int,
  ? rssi: 7 => int,
}
