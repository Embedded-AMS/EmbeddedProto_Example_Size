; CDDL counterpart of repeated_demo.proto for zcbor. The maximum counts match the
; Embedded Proto template parameters and the nanopb max_count options.

Repeated_Integers = {
  ? values: 1 => [0*10 int],
}

Repeated_Messages = {
  ? items: 1 => [0*5 Simple_Types],
}

Nested_Repeated_Messages = {
  ? nested_rm: 1 => [0*10 Repeated_Messages],
}
