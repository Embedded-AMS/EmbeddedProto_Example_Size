// FlatBuffers counterpart of optional_demo.proto. Every field is an optional scalar
// (= null), so a value equal to the default is still stored and reported present.

include "simple_types.fbs";

table Optional_Demo
{
  a_int32:int = null;
  a_int64:long = null;
  a_uint32:uint = null;
  a_uint64:ulong = null;
  a_sint32:int = null;
  a_sint64:long = null;
  a_bool:bool = null;
  a_enum:Test_Enum = null;
  a_fixed64:ulong = null;
  a_sfixed64:long = null;
  a_double:double = null;
  a_fixed32:uint = null;
  a_sfixed32:int = null;
  a_float:float = null;
  a_nested_enum:Nested_Enum = null;
}

root_type Optional_Demo;
